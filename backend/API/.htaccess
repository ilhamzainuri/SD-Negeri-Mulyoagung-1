# =============================================================

# Proteksi folder API - SD Negeri 1 Mulyoagung

# =============================================================

Options -Indexes -ExecCGI

# Sembunyikan informasi server

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always unset Server
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# Hanya izinkan file .php diakses, blokir file lainnya

<FilesMatch "^(?!._\.php$)._$">
Order Allow,Deny
Deny from all
</FilesMatch>

# Blokir akses ke file helper (hanya boleh di-include via PHP, bukan HTTP)

<FilesMatch "^(foto_helper|rate_limiter|helper|functions|utils)\.php$">
Order Allow,Deny
Deny from all
</FilesMatch>

# Izinkan akses API (Proteksi endpoint ditangani oleh CORS & Sec-Fetch-Mode di koneksi.php)
Require all granted

